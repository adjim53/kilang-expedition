// Kilang Mountain Expedition 2026 — data model (PostgreSQL, e.g. Neon on Vercel)

// Prisma 7 client: pure TypeScript, no native engine binary. The database is
// reached through a driver adapter — see src/lib/prisma.ts.
generator client {
  provider = "prisma-client-js"
}

// Connection strings are in prisma.config.ts (Prisma 7): DATABASE_URL (pooled,
// used by the site) and DATABASE_URL_UNPOOLED (direct, used by migrations).
datasource db {
  provider = "postgresql"
}

model Registration {
  id          String  @id @default(cuid())
  reference   String  @unique // registration reference, e.g. KIL26-M3K9Q2X7TB4H
  accessToken String  @unique // secret token that unlocks the digital pass page
  passId      String? @unique // KIL-2026-XXXX, assigned the moment the form is submitted
  // REGISTERED | CANCELLED. PENDING only exists on rows from before registration
  // became free (checkout started, never paid); staff can confirm those.
  status      String  @default("PENDING")

  fullName       String
  email          String
  phone          String // normalised to 234XXXXXXXXXX
  nextOfKinName  String
  nextOfKinPhone String
  bloodGroup     String
  genotype       String
  experience     String // BEGINNER | INTERMEDIATE | PRO
  medicalNotes   String?
  kitSize        String // S | M | L | XL | XXL

  waiverAcceptedAt DateTime
  emailSentAt      DateTime?
  smsSentAt        DateTime?
  emailError       String? // last delivery failure, shown to staff
  smsError         String?

  medicalCheckedAt DateTime? // Dec 30 medical checkup
  medicalCheckedBy String? // staff name
  musterCheckedAt  DateTime? // Dec 31 4:00 AM Popandi muster — start of the ascent
  musterCheckedBy  String?
  summitReachedAt  DateTime? // scanned at the summit
  summitReachedBy  String?
  descentCheckedAt DateTime? // scanned back at the base — safely off the mountain
  descentCheckedBy String?

  // Kept from when registration was paid for (before 24 Nov 2026). Never set on
  // new registrations; shown to staff so earlier payments can be traced or refunded.
  legacyTicket String? // name of the ticket bought
  amountKobo   Int     @default(0)
  paidAt       DateTime?
  paystackTxId String?

  cancelledAt  DateTime?
  cancelReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fullName])
  @@index([email])
  @@index([phone])
  @@index([status])
}

/// Donations from well-wishers and partners, received through Paystack.
model Donation {
  id           String    @id @default(cuid())
  reference    String    @unique // Paystack transaction reference, e.g. KILD-M3K9Q2X7TB4H
  status       String    @default("PENDING") // PENDING | PAID
  amountKobo   Int // pledged at checkout; replaced by what Paystack actually received
  donorType    String // INDIVIDUAL | PARTNER
  donorName    String
  organisation String?
  email        String
  phone        String? // normalised to 234XXXXXXXXXX
  message      String?
  paidAt       DateTime?
  paystackTxId String?
  receiptSentAt DateTime?
  receiptError  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
}

// ── Back office ─────────────────────────────────────────────────────────────

model AdminUser {
  id                 String         @id @default(cuid())
  email              String         @unique // stored lower-case
  name               String
  passwordHash       String // scrypt — see src/lib/auth/password.ts
  role               String         @default("MARSHAL") // ADMIN | STAFF | MARSHAL
  active             Boolean        @default(true)
  mustChangePassword Boolean        @default(true)
  lastLoginAt        DateTime?
  sessions           AdminSession[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

model AdminSession {
  id        String    @id @default(cuid())
  tokenHash String    @unique // sha256 of the cookie value; the raw token is never stored
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  ip        String?
  userAgent String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Who did what in the back office. Never deleted by the app.
model AuditLog {
  id             String   @id @default(cuid())
  actorId        String?
  actorName      String
  action         String // e.g. checkin.medical, registration.edit, user.create
  registrationId String?
  targetUserId   String?
  details        String? // JSON
  createdAt      DateTime @default(now())

  @@index([registrationId])
  @@index([createdAt])
}

/// Fixed-window counters for login and registration rate limits. Stored in
/// the database so limits hold across serverless instances.
model RateLimit {
  key     String   @id // e.g. "login:ip:1.2.3.4"
  count   Int
  resetAt DateTime
}
