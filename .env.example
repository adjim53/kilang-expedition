# ── Database ────────────────────────────────────────────────────────────────
# SQLite for local development. For PostgreSQL/Supabase, change the provider in
# prisma/schema.prisma and use a postgres:// connection string here.
DATABASE_URL="file:./dev.db"

# ── Site ────────────────────────────────────────────────────────────────────
# Public base URL of the deployed site (used in emails, SMS and QR codes).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Paystack (https://dashboard.paystack.com/#/settings/developers) ─────────
# Leave both empty in development to use the built-in "demo payment" mode.
PAYSTACK_SECRET_KEY=""
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""

# ── Resend (https://resend.com/api-keys) ────────────────────────────────────
RESEND_API_KEY=""
# Must be an address on a domain you have VERIFIED in Resend (Domains page).
# `npm run check:integrations` tells you if it is not.
EMAIL_FROM="Kilang Expedition <passes@your-domain.com>"

# ── Termii (https://accounts.termii.com) ────────────────────────────────────
TERMII_API_KEY=""
TERMII_SENDER_ID="Kilang"
# Optional: your account-specific base URL from the Termii dashboard.
TERMII_BASE_URL="https://api.ng.termii.com"
# "generic" (default) or "dnd" — the transactional route that reaches DND
# numbers; it must be enabled on your Termii account first.
TERMII_CHANNEL="generic"

# ── Admin check-in portal ───────────────────────────────────────────────────
# The PIN marshals type at /admin/checkin. Use something long and unguessable.
ADMIN_SECRET_KEY="change-me"
